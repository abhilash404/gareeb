{
  "name": "isogame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sprites": "node tools/make-sprites.mjs && npm run atlas",
    "atlas": "node tools/pack-atlas.mjs",
    "import-character": "node tools/import-pixellab.mjs",
    "dev": "npm run atlas && concurrently -k -n server,game -c magenta,cyan \"npm:server\" \"npm:client\"",
    "server": "tsx watch server/index.ts --dev",
    "client": "vite",
    "bot": "tsx tools/bot.ts",
    "build": "npm run atlas && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.42",
    "@colyseus/sdk": "^0.18.8",
    "@supabase/supabase-js": "^2.118.0",
    "colyseus": "^0.18.10",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "phaser": "^3.90.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
